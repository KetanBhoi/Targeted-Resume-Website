{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "ketan-resume": {
      "root": "artifacts/ketan-resume",
      "framework": "vite",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/__mockup",
      "destination": { "service": "mockup-sandbox" }
    },
    {
      "source": "/__mockup/(.*)",
      "destination": { "service": "mockup-sandbox" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "ketan-resume" }
    }
  ]
}

